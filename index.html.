<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baggira Mobile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f6f8;
      color: #222;
      min-height: 100vh;
      padding-bottom: 80px;
    }

    header {
      background: #ffffff;
      padding: 18px;
      text-align: center;
      border-bottom: 1px solid #ddd;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 {
      color: #d47b00;
      font-size: 26px;
    }

    header p {
      color: #777;
      margin-top: 5px;
      font-size: 14px;
    }

    .container {
      width: 92%;
      max-width: 500px;
      margin: 20px auto;
    }

    .balance-card {
      background: linear-gradient(135deg, #d47b00, #f0a52b);
      color: white;
      border-radius: 20px;
      padding: 25px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.15);
    }

    .balance-card p {
      font-size: 14px;
      opacity: 0.9;
    }

    .balance {
      font-size: 34px;
      font-weight: bold;
      margin-top: 10px;
    }

    .currency {
      font-size: 16px;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
      margin-top: 22px;
    }

    button {
      border: none;
      cursor: pointer;
      transition: 0.2s;
    }

    button:active {
      transform: scale(0.97);
    }

    .action-btn {
      background: white;
      border-radius: 16px;
      padding: 20px 10px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
      font-size: 16px;
      font-weight: bold;
    }

    .action-btn span {
      display: block;
      font-size: 30px;
      margin-bottom: 8px;
    }

    .send {
      color: #d47b00;
    }

    .receive {
      color: #159447;
    }

    .messages {
      color: #4b63d3;
    }

    .wallet {
      color: #8b4bc7;
    }

    .section {
      display: none;
      background: white;
      margin-top: 22px;
      padding: 22px;
      border-radius: 18px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    .section.active {
      display: block;
    }

    .section h2 {
      margin-bottom: 18px;
      color: #333;
    }

    input,
    textarea {
      width: 100%;
      padding: 14px;
      margin: 8px 0 12px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 16px;
      outline: none;
    }

    input:focus,
    textarea:focus {
      border-color: #d47b00;
    }

    .main-btn {
      width: 100%;
      background: #d47b00;
      color: white;
      padding: 14px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
      margin-top: 5px;
    }

    .receive-btn {
      background: #159447;
    }

    .message-btn {
      background: #4b63d3;
    }

    .transaction {
      padding: 14px 0;
      border-bottom: 1px solid #eee;
      display: flex;
      justify-content: space-between;
    }

    .transaction:last-child {
      border-bottom: none;
    }

    .positive {
      color: #159447;
      font-weight: bold;
    }

    .negative {
      color: #d33;
      font-weight: bold;
    }

    .empty {
      color: #777;
      text-align: center;
      padding: 20px 0;
    }

    nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 68px;
      background: white;
      border-top: 1px solid #ddd;
      display: flex;
      justify-content: space-around;
      align-items: center;
      z-index: 20;
    }

    nav button {
      background: none;
      color: #777;
      font-size: 12px;
      padding: 8px;
    }

    nav button span {
      display: block;
      font-size: 23px;
      margin-bottom: 2px;
    }

    .home-title {
      margin-top: 25px;
      margin-bottom: 10px;
      font-size: 19px;
    }

    .success {
      background: #e7f7ed;
      color: #137a39;
      padding: 12px;
      border-radius: 10px;
      margin-top: 12px;
      display: none;
    }

    .copy-box {
      background: #f4f6f8;
      padding: 15px;
      border-radius: 10px;
      text-align: center;
      margin-bottom: 15px;
    }

    .copy-box strong {
      font-size: 20px;
    }
  </style>
</head>

<body>

  <header>
    <h1>💳 Baggira Mobile</h1>
    <p>Messagerie & services monétaires</p>
  </header>

  <div class="container">

    <!-- ACCUEIL -->
    <div id="home" class="page active">

      <div class="balance-card">
        <p>Solde disponible</p>
        <div class="balance">
          <span id="balance">250000</span>
          <span class="currency">CDF</span>
        </div>
      </div>

      <h2 class="home-title">Actions rapides</h2>

      <div class="actions">

        <button class="action-btn send" onclick="showSection('sendSection')">
          <span>📤</span>
          Envoyer
        </button>

        <button class="action-btn receive" onclick="showSection('receiveSection')">
          <span>📥</span>
          Recevoir
        </button>

        <button class="action-btn messages" onclick="showSection('messagesSection')">
          <span>💬</span>
          Messages
        </button>

        <button class="action-btn wallet" onclick="showSection('walletSection')">
          <span>💰</span>
          Portefeuille
        </button>

      </div>

    </div>


    <!-- ENVOYER -->
    <div id="sendSection" class="section">

      <h2>📤 Envoyer de l'argent</h2>

      <input
        type="tel"
        id="recipient"
        placeholder="Numéro du destinataire">

      <input
        type="number"
        id="sendAmount"
        placeholder="Montant en CDF">

      <button class="main-btn" onclick="sendMoney()">
        Envoyer maintenant
      </button>

      <div id="sendSuccess" class="success"></div>

    </div>


    <!-- RECEVOIR -->
    <div id="receiveSection" class="section">

      <h2>📥 Recevoir de l'argent</h2>

      <div class="copy-box">
        <p>Votre numéro Baggira</p>
        <strong>+243 000 000 000</strong>
      </div>

      <p style="text-align:center; color:#666; margin-bottom:15px;">
        Partagez ce numéro avec la personne qui souhaite vous envoyer de l'argent.
      </p>

      <button class="main-btn receive-btn" onclick="copyNumber()">
        📋 Copier mon numéro
      </button>

      <div id="copySuccess" class="success">
        Numéro copié !
      </div>

    </div>


    <!-- MESSAGES -->
    <div id="messagesSection" class="section">

      <h2>💬 Messages</h2>

      <textarea
        id="messageText"
        rows="4"
        placeholder="Écrivez votre message..."></textarea>

      <button class="main-btn message-btn" onclick="sendMessage()">
        Envoyer le message
      </button>

      <div id="messageList" style="margin-top:20px;"></div>

    </div>


    <!-- PORTEFEUILLE -->
    <div id="walletSection" class="section">

      <h2>💰 Portefeuille</h2>

      <div class="balance-card" style="margin-bottom:15px;">
        <p>Solde actuel</p>
        <div class="balance">
          <span id="walletBalance">250000</span>
          <span class="currency">CDF</span>
        </div>
