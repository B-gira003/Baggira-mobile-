<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baggira Mobile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f6f8;
      color: #222;
      padding-bottom: 90px;
    }

    .header {
      background: #07845f;
      color: white;
      padding: 28px 22px 35px;
      border-radius: 0 0 30px 30px;
    }

    .header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    .header p {
      opacity: 0.9;
    }

    .balance {
      background: white;
      color: #222;
      margin-top: 22px;
      padding: 20px;
      border-radius: 18px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .balance small {
      color: #777;
    }

    .balance h2 {
      margin-top: 8px;
      color: #07845f;
      font-size: 28px;
    }

    .container {
      padding: 20px;
    }

    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-top: 5px;
    }

    .action {
      border: none;
      background: white;
      padding: 22px 10px;
      border-radius: 18px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .action:active {
      transform: scale(0.97);
    }

    .icon {
      font-size: 30px;
      display: block;
      margin-bottom: 8px;
    }

    .send {
      color: #07845f;
    }

    .receive {
      color: #2563eb;
    }

    .messages {
      color: #9333ea;
    }

    .wallet {
      color: #ea580c;
    }

    .section {
      margin-top: 28px;
    }

    .section h3 {
      margin-bottom: 12px;
    }

    .transaction {
      background: white;
      padding: 16px;
      border-radius: 15px;
      margin-bottom: 10px;
      display: flex;
      justify-content: space-between;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .green {
      color: #07845f;
      font-weight: bold;
    }

    .red {
      color: #dc2626;
      font-weight: bold;
    }

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      height: 72px;
      background: white;
      display: flex;
      justify-content: space-around;
      align-items: center;
      box-shadow: 0 -3px 12px rgba(0,0,0,0.1);
    }

    .nav-btn {
      border: none;
      background: none;
      font-size: 13px;
      color: #555;
      cursor: pointer;
    }

    .nav-icon {
      display: block;
      font-size: 23px;
      margin-bottom: 3px;
    }

    .active {
      color: #07845f;
      font-weight: bold;
    }

    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      justify-content: center;
      align-items: center;
      padding: 20px;
      z-index: 10;
    }

    .modal-content {
      background: white;
      width: 100%;
      max-width: 400px;
      border-radius: 20px;
      padding: 25px;
    }

    .modal-content h2 {
      margin-bottom: 18px;
      color: #07845f;
    }

    .modal-content input,
    .modal-content textarea {
      width: 100%;
      padding: 13px;
      margin-bottom: 12px;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 16px;
    }

    .primary {
      width: 100%;
      border: none;
      padding: 14px;
      background: #07845f;
      color: white;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    .close {
      width: 100%;
      border: none;
      padding: 12px;
      margin-top: 10px;
      background: #eee;
      border-radius: 10px;
      cursor: pointer;
    }
  </style>
</head>

<body>

  <div class="header">
    <h1>Baggira Mobile</h1>
    <p>Bienvenue 👋</p>

    <div class="balance">
      <small>Solde disponible</small>
      <h2>250 000 CDF</h2>
    </div>
  </div>

  <div class="container">

    <div class="actions">

      <button class="action send" onclick="openModal('sendModal')">
        <span class="icon">💸</span>
        Envoyer
      </button>

      <button class="action receive" onclick="openModal('receiveModal')">
        <span class="icon">📥</span>
        Recevoir
      </button>

      <button class="action messages" onclick="openModal('messageModal')">
        <span class="icon">💬</span>
        Messages
      </button>

      <button class="action wallet" onclick="openModal('walletModal')">
        <span class="icon">👛</span>
        Portefeuille
      </button>

    </div>

    <div class="section">
      <h3>Transactions récentes</h3>

      <div class="transaction">
        <span>💰 Dépôt</span>
        <span class="green">+100 000 CDF</span>
      </div>

      <div class="transaction">
        <span>💸 Transfert</span>
        <span class="red">-50 000 CDF</span>
      </div>

      <div class="transaction">
        <span>💰 Dépôt</span>
        <span class="green">+200 000 CDF</span>
      </div>

    </div>

  </div>

  <!-- MODAL ENVOYER -->
  <div class="modal" id="sendModal">
    <div class="modal-content">
      <h2>💸 Envoyer de l'argent</h2>

      <input type="tel" placeholder="Numéro du destinataire">

      <input type="number" placeholder="Montant en CDF">

      <button class="primary" onclick="sendMoney()">
        Envoyer
      </button>

      <button class="close" onclick="closeModal('sendModal')">
        Annuler
      </button>
    </div>
  </div>

  <!-- MODAL RECEVOIR -->
  <div class="modal" id="receiveModal">
    <div class="modal-content">
      <h2>📥 Recevoir de l'argent</h2>

      <p style="margin-bottom:18px;">
        Votre numéro Baggira Mobile :
      </p>

      <input type="text" value="+243 000 000 000" readonly>

      <button class="primary" onclick="copyNumber()">
        Copier mon numéro
      </button>

      <button class="close" onclick="closeModal('receiveModal')">
        Fermer
      </button>
    </div>
  </div>

  <!-- MODAL MESSAGES -->
  <div class="modal" id="messageModal">
    <div class="modal-content">
      <h2>💬 Messages</h2>

      <textarea rows="5" placeholder="Écrivez votre message..."></textarea>

      <button class="primary" onclick="sendMessage()">
        Envoyer le message
      </button>

      <button class="close" onclick="closeModal('messageModal')">
        Fermer
      </button>
    </div>
  </div>

  <!-- MODAL PORTEFEUILLE -->
  <div class="modal" id="walletModal">
    <div class="modal-content">
      <h2>👛 Mon portefeuille</h2>

      <p style="margin-bottom:10px;">
        Solde actuel :
      </p>

      <h2>250 000 CDF</h2>

      <p style="margin-top:15px;">
        Dépôts : 300 000 CDF
      </p>

      <p style="margin-top:8px;">
        Transferts : 50 000 CDF
      </p>

      <button class="close" onclick="closeModal('walletModal')">
        Fermer
      </button>
    </div>
  </div>

  <!-- MENU DU BAS -->
  <div class="bottom-nav">

    <button class="nav-btn active" onclick="goHome()">
      <span class="nav-icon">🏠</span>
      Accueil
    </button>

    <button class="nav-btn" onclick="openModal('walletModal')">
      <span class="nav-icon">👛</span>
      Portefeuille
    </button>

    <button class="nav-btn" onclick="openModal('messageModal')">
      <span class="nav-icon">💬</span>
      Messages
    </button>

    <button class="nav-btn" onclick="openModal('sendModal')">
      <span class="nav-icon">💸</span>
      Envoyer
    </button>

  </div>

  <script>

    function openModal(id) {
      document.getElementById(id).style.display = "flex";
    }

    function closeModal(id) {
      document.getElementById(id).style.display = "none";
    }

    function sendMoney() {
      alert("Demande d'envoi enregistrée. Cette version est un prototype.");
      closeModal("sendModal");
    }

    function sendMessage() {
      alert("Message envoyé avec succès !");
      closeModal("messageModal");
    }

    function copyNumber() {
      navigator.clipboard.writeText("+243 000 000 000");
      alert("Numéro copié !");
    }

    function goHome() {
      window.scrollTo({
        top: 0,
        behavior: "smooth"
      });
    }

  </script>

</body>
</html>
