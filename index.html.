<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baggira Mobile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f2f5f8;
      color: #222;
    }

    .app {
      max-width: 480px;
      margin: auto;
      min-height: 100vh;
      background: white;
    }

    header {
      background: #075e54;
      color: white;
      padding: 25px 20px;
      text-align: center;
    }

    header h1 {
      font-size: 28px;
      margin-bottom: 8px;
    }

    header p {
      font-size: 14px;
    }

    .balance {
      margin: 20px;
      padding: 25px;
      border-radius: 15px;
      background: #0b806f;
      color: white;
      text-align: center;
    }

    .balance p {
      font-size: 14px;
      margin-bottom: 8px;
    }

    .balance h2 {
      font-size: 30px;
    }

    .buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      padding: 20px;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 22px 10px;
      font-size: 16px;
      font-weight: bold;
      background: #e8f5f2;
      color: #075e54;
      cursor: pointer;
    }

    button:active {
      transform: scale(0.98);
    }

    .section {
      display: none;
      margin: 0 20px 20px;
      padding: 20px;
      border-radius: 12px;
      background: #f5f5f5;
    }

    .section h3 {
      color: #075e54;
      margin-bottom: 15px;
    }

    .section input {
      width: 100%;
      padding: 13px;
      margin: 8px 0;
      border: 1px solid #ccc;
      border-radius: 8px;
    }

    .action {
      width: 100%;
      background: #075e54;
      color: white;
      margin-top: 10px;
    }

    .close {
      background: #ddd;
      color: #333;
      width: 100%;
      margin-top: 8px;
    }

    .footer {
      text-align: center;
      padding: 25px;
      color: #777;
      font-size: 13px;
    }
  </style>
</head>

<body>

<div class="app">

  <header>
    <h1>Baggira Mobile</h1>
    <p>Messagerie & services monétaires</p>
  </header>

  <div class="balance">
    <p>Solde disponible</p>
    <h2>250 000 CDF</h2>
  </div>

  <div class="buttons">
    <button onclick="showSection('send')">💸<br>Envoyer</button>
    <button onclick="showSection('receive')">📥<br>Recevoir</button>
    <button onclick="showSection('messages')">💬<br>Messages</button>
    <button onclick="showSection('wallet')">💰<br>Portefeuille</button>
  </div>

  <div id="send" class="section">
    <h3>Envoyer de l'argent</h3>

    <input type="text" placeholder="Numéro du bénéficiaire">
    <input type="number" placeholder="Montant en CDF">

    <button class="action" onclick="alert('Transfert simulé avec succès !')">
      Envoyer
    </button>

    <button class="close" onclick="closeSections()">Fermer</button>
  </div>

  <div id="receive" class="section">
    <h3>Recevoir de l'argent</h3>

    <p>Votre numéro Baggira :</p>
    <br>
    <strong>+243 XXX XXX XXX</strong>

    <button class="close" onclick="closeSections()">Fermer</button>
  </div>

  <div id="messages" class="section">
    <h3>Messages</h3>

    <p>📩 Aucun nouveau message.</p>

    <button class="close" onclick="closeSections()">Fermer</button>
  </div>

  <div id="wallet" class="section">
    <h3>Portefeuille</h3>

    <p>Solde : <strong>250 000 CDF</strong></p>
    <br>
    <p>Historique :</p>
    <br>
    <p>• Aucun transfert récent</p>

    <button class="close" onclick="closeSections()">Fermer</button>
  </div>

  <div class="footer">
    © 2026 Baggira Mobile
  </div>

</div>

<script>
  function showSection(id) {
    closeSections();
    document.getElementById(id).style.display = "block";
  }

  function closeSections() {
    document.getElementById("send").style.display = "none";
    document.getElementById("receive").style.display = "none";
    document.getElementById("messages").style.display = "none";
    document.getElementById("wallet").style.display = "none";
  }
</script>

</body>
</html>
