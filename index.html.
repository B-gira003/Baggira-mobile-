<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Baggira Mobile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7f6;
      color: #17201d;
      min-height: 100vh;
    }

    button,
    input,
    textarea {
      font-family: inherit;
    }

    .app {
      max-width: 700px;
      margin: auto;
      min-height: 100vh;
      background: #f4f7f6;
      padding-bottom: 90px;
    }

    /* HEADER */

    header {
      background: #07865f;
      color: white;
      padding: 24px 20px 28px;
      border-radius: 0 0 28px 28px;
    }

    .brand {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 25px;
    }

    .brand h1 {
      font-size: 26px;
    }

    .brand span {
      background: rgba(255,255,255,0.18);
      padding: 9px 12px;
      border-radius: 20px;
      font-size: 13px;
    }

    .welcome {
      font-size: 16px;
      margin-bottom: 10px;
      opacity: 0.95;
    }

    .balance {
      font-size: 34px;
      font-weight: bold;
      margin-bottom: 5px;
    }

    .balance-label {
      opacity: 0.85;
      font-size: 14px;
    }

    /* CONTENT */

    main {
      padding: 20px;
    }

    .section {
      display: none;
    }

    .section.active {
      display: block;
    }

    .card {
      background: white;
      border-radius: 24px;
      padding: 22px;
      margin-bottom: 18px;
      box-shadow: 0 5px 22px rgba(0,0,0,0.06);
    }

    .card h2 {
      font-size: 22px;
      margin-bottom: 18px;
    }

    .card h3 {
      margin-bottom: 12px;
    }

    /* QUICK ACTIONS */

    .quick-title {
      font-size: 22px;
      margin-bottom: 16px;
    }

    .quick-actions {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .quick-btn {
      border: none;
      background: #eef8f4;
      border-radius: 20px;
      padding: 22px 10px;
      cursor: pointer;
      font-size: 16px;
      transition: 0.2s;
    }

    .quick-btn:hover {
      transform: translateY(-2px);
      background: #e1f4ed;
    }

    .quick-icon {
      display: block;
      font-size: 35px;
      margin-bottom: 10px;
    }

    /* FORM */

    label {
      display: block;
      margin-bottom: 7px;
      font-weight: bold;
      font-size: 14px;
    }

    input,
    textarea {
      width: 100%;
      border: 1px solid #d7dfdc;
      border-radius: 14px;
      padding: 14px;
      font-size: 16px;
      outline: none;
      margin-bottom: 15px;
      background: #fafcfb;
    }

    input:focus,
    textarea:focus {
      border-color: #07865f;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .primary-btn {
      width: 100%;
      border: none;
      border-radius: 15px;
      padding: 15px;
      background: #07865f;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    .primary-btn:active {
      transform: scale(0.98);
    }

    .secondary-btn {
      width: 100%;
      border: none;
      border-radius: 15px;
      padding: 14px;
      background: #edf2f0;
      color: #17201d;
      font-size: 16px;
      cursor: pointer;
      margin-top: 10px;
    }

    /* TRANSACTIONS */

    .transaction {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      border-bottom: 1px solid #edf0ef;
    }

    .transaction:last-child {
      border-bottom: none;
    }

    .transaction-left {
      display: flex;
      gap: 12px;
      align-items: center;
    }

    .transaction-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #eef8f4;
      display: flex;
      justify-content: center;
      align-items: center;
      font-size: 20px;
    }

    .transaction-title {
      font-weight: bold;
      margin-bottom: 4px;
    }

    .transaction-date {
      font-size: 12px;
      color: #7a8581;
    }

    .amount {
      font-weight: bold;
    }

    .sent {
      color: #d84b4b;
    }

    .received {
      color: #07865f;
    }

    /* RECEIVE */

    .receive-box {
      text-align: center;
      background: #eef8f4;
      padding: 25px;
      border-radius: 20px;
      margin-bottom: 20px;
    }

    .receive-number {
      font-size: 25px;
      font-weight: bold;
      margin: 12px 0;
      color: #07865f;
    }

    .qr {
      width: 170px;
      height: 170px;
      background:
        linear-gradient(90deg, #111 10px, transparent 10px) 0 0/25px 25px,
        linear-gradient(#111 10px, transparent 10px) 0 0/25px 25px,
        white;
      border: 12px solid white;
      margin: 15px auto;
      box-shadow: 0 3px 15px rgba(0,0,0,0.1);
    }

    /* MESSAGES */

    .messages {
      max-height: 350px;
      overflow-y: auto;
      margin-bottom: 15px;
    }

    .message {
      padding: 11px 14px;
      border-radius: 15px;
      margin-bottom: 10px;
      max-width: 85%;
      background: #edf2f0;
    }

    .message.me {
      margin-left: auto;
      background: #07865f;
      color: white;
    }

    .message small {
      display: block;
      opacity: 0.65;
      margin-top: 5px;
      font-size: 10px;
    }

    /* NAVIGATION */

    .bottom-nav {
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: min(700px, 100%);
      background: white;
      border-top: 1px solid #e3e8e6;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      padding: 8px 5px;
      z-index: 100;
    }

    .nav-btn {
      border: none;
      background: transparent;
      padding: 8px 3px;
      color: #69736f;
      cursor: pointer;
      font-size: 12px;
    }

    .nav-btn span {
      display: block;
      font-size: 22px;
      margin-bottom: 4px;
    }

    .nav-btn.active {
      color: #07865f;
      font-weight: bold;
    }

    /* NOTIFICATION */

    .toast {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translate(-50%, -100px);
      background: #17201d;
      color: white;
      padding: 14px 18px;
      border-radius: 12px;
      z-index: 200;
      transition: 0.3s;
      max-width: 90%;
      text-align: center;
    }

    .toast.show {
      transform: translate(-50%, 0);
    }

    .empty {
      text-align: center;
      color: #7a8581;
      padding: 20px 0;
    }

    @media (max-width: 380px) {
      .balance {
        font-size: 29px;
      }

      .quick-btn {
        padding: 18px 5px;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- HEADER -->
  <header>
    <div class="brand">
      <h1>Baggira Mobile</h1>
      <span>Prototype</span>
    </div>

    <div class="welcome">
      Bienvenue 👋
    </div>

    <div class="balance" id="headerBalance">
      250 000 CDF
    </div>

    <div class="balance-label">
      Solde disponible
    </div>
  </header>


  <main>

    <!-- ACCUEIL -->
    <section id="home" class="section active">

      <div class="card">

        <div class="quick-title">
          Actions rapides
        </div>

        <div class="quick-actions">

          <button class="quick-btn" onclick="showSection('send')">
            <span class="quick-icon">💸</span>
            Envoyer
          </button>

          <button class="quick-btn" onclick="showSection('receive')">
            <span class="quick-icon">📥</span>
            Recevoir
          </button>

          <button class="quick-btn" onclick="showSection('messages')">
            <span class="quick-icon">💬</span>
            Messages
          </button>

          <button class="quick-btn" onclick="showSection('wallet')">
            <span class="quick-icon">💰</span>
            Portefeuille
          </button>

        </div>
      </div>


      <div class="card">
        <h2>Dernières opérations</h2>

        <div id="homeTransactions">
          <div class="empty">
            Aucune opération récente
          </div>
        </div>
      </div>

    </section>


    <!-- ENVOYER -->
    <section id="send" class="section">

      <div class="card">

        <h2>💸 Envoyer de l'argent</h2>

        <label for="sendPhone">
          Numéro du destinataire
        </label>

        <input
          id="sendPhone"
          type="tel"
          placeholder="Ex : 0990000000"
        >

        <label for="sendAmount">
          Montant en CDF
        </label>

        <input
          id="sendAmount"
          type="number"
          min="1"
          placeholder="Ex : 10000"
        >

        <label for="sendReason">
          Motif
        </label>

        <input
          id="sendReason"
          type="text"
          placeholder="Ex : Transfert"
        >

        <button
          class="primary-btn"
          onclick="sendMoney()">
          Envoyer maintenant
        </button>

        <button
          class="secondary-btn"
          onclick="showSection('home')">
          Annuler
        </button>

      </div>

    </section>


    <!-- RECEVOIR -->
    <section id="receive" class="section">

      <div class="card">

        <h2>📥 Recevoir de l'argent</h2>

        <div class="receive-box">

          <div>
            Mon numéro Baggira
          </div>

          <div class="receive-number">
            099 000 0000
          </div>

          <div class="qr"></div>

          <div>
            Scannez ce code ou utilisez mon numéro
            pour effectuer un transfert.
          </div>

        </div>

        <button
          class="primary-btn"
          onclick="copyNumber()">
          Copier mon numéro
        </button>

      </div>

    </section>


    <!-- MESSAGES -->
    <section id="messages" class="section">

      <div class="card">

        <h2>💬 Messages</h2>

        <div
          id="messageList"
          class="messages">
        </div>

        <label for="messageInput">
          Nouveau message
        </label>

        <textarea
          id="messageInput"
          placeholder="Écrivez votre message...">
        </textarea>

        <button
          class="primary-btn"
          onclick="sendMessage()">
          Envoyer le message
        </button>

      </div>

    </section>


    <!-- PORTEFEUILLE -->
    <section id="wallet" class="section">

      <div class="card">

        <h2>💰 Mon portefeuille</h2>

        <div class="receive-box">

          <div>
            Solde disponible
          </div>

          <div class="balance" id="walletBalance">
            250 000 CDF
          </div>

        </div>

        <h3>Historique</h3>

        <div id="transactions">
          <div class="empty">
            Aucune transaction
          </div>
        </div>

      </div>

    </section>

  </main>


  <!-- NAVIGATION -->
  <nav class="bottom-nav">

    <button
      class="nav-btn active"
      id="nav-home"
      onclick="showSection('home')">
      <span>🏠</span>
      Accueil
    </button>

    <button
      class="nav-btn"
      id="nav-send"
      onclick="showSection('send')">
      <span>💸</span>
      Envoyer
    </button>

    <button
      class="nav-btn"
      id="nav-messages"
      onclick="showSection('messages')">
      <span>💬</span>
      Messages
    </button>

    <button
      class="nav-btn"
      id="nav-wallet"
      onclick="showSection('wallet')">
      <span>💰</span>
      Portefeuille
    </button>

  </nav>

</div>


<!-- NOTIFICATION -->
<div id="toast" class="toast"></div>


<script>

  /* =========================
     DONNÉES
  ========================= */

  let balance =
    Number(localStorage.getItem("baggiraBalance")) || 250000;

  let transactions =
    JSON.parse(
      localStorage.getItem("baggiraTransactions") || "[]"
    );

  let messages =
    JSON.parse(
      localStorage.getItem("baggiraMessages") || "[]"
    );


  /* =========================
     AFFICHAGE DU SOLDE
  ========================= */

  function formatCDF(amount) {

    return Number(amount).toLocaleString("fr-FR") + " CDF";

  }


  function updateBalance() {

    document.getElementById("headerBalance").textContent =
      formatCDF(balance);

    document.getElementById("walletBalance").textContent =
      formatCDF(balance);

    localStorage.setItem(
      "baggiraBalance",
      balance
    );

  }


  /* =========================
     NAVIGATION
  ========================= */

  function showSection(sectionName) {

    const sections =
      document.querySelectorAll(".section");

    sections.forEach(section => {
      section.classList.remove("active");
    });

    const selected =
      document.getElementById(sectionName);

    if (selected) {
      selected.classList.add("active");
    }


    document
      .querySelectorAll(".nav-btn")
      .forEach(btn => {
        btn.classList.remove("active");
      });


    const nav =
      document.getElementById("nav-" + sectionName);

    if (nav) {
      nav.classList.add("active");
    }


    renderTransactions();
    renderMessages();

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

  }


  /* =========================
     NOTIFICATION
  ========================= */

  function toast(message) {

    const element =
      document.getElementById("toast");

    element.textContent = message;

    element.classList.add("show");

    setTimeout(() => {

      element.classList.remove("show");

    }, 2500);

  }


  /* =========================
     ENVOYER ARGENT
  ========================= */

  function sendMoney() {

    const phone =
      document.getElementById("sendPhone").value.trim();

    const amount =
      Number(
        document.getElementById("sendAmount").value
      );

    const reason =
      document.getElementById("sendReason").value.trim()
      || "Transfert";


    if (!phone) {

      toast("Veuillez entrer le numéro du destinataire.");

      return;
    }


    if (!amount || amount <= 0) {

      toast("Veuillez entrer un montant valide.");

      return;
    }


    if (amount > balance) {

      toast("Solde insuffisant.");

      return;
    }


    const confirmation =
      confirm(
        "Confirmer l'envoi de " +
        formatCDF(amount) +
        " à " +
        phone +
        " ?"
      );


    if (!confirmation) {

      return;
    }


    balance -= amount;


    transactions.unshift({

      type: "sent",

      title: "Envoi à " + phone,

      amount: amount,

      reason: reason,

      date: new Date().toLocaleString("fr-FR")

    });


    saveData();

    updateBalance();

    renderTransactions();


    document.getElementById("sendPhone").value = "";

    document.getElementById("sendAmount").value = "";

    document.getElementById("sendReason").value = "";


    toast(
      "Transfert effectué : " +
      formatCDF(amount)
    );


    setTimeout(() => {

      showSection("wallet");

    }, 1000);

  }


  /* =========================
     RECEVOIR
  ========================= */

  function copyNumber() {

    const number = "0990000000";


    if (
      navigator.clipboard &&
      navigator.clipboard.writeText
    ) {

      navigator.clipboard
        .writeText(number)
        .then(() => {

          toast("Numéro copié !");

        });

    } else {

      toast("Mon numéro : " + number);

    }

  }


  /* =========================
     TRANSACTIONS
  ========================= */

  function renderTransactions() {

    const containers = [

      document.getElementById("transactions"),

      document.getElementById("homeTransactions")

    ];


    containers.forEach(container => {

      if (!container) return;


      if (transactions.length === 0) {

        container.innerHTML =
          '<div class="empty">Aucune transaction</div>';

        return;

      }


      const list =
        transactions
          .slice(0, 10)
          .map(transaction => {

            const isSent =
              transaction.type === "sent";


            return `

              <div class="transaction">

                <div class="transaction-left">

                  <div class="transaction-icon">
                    ${isSent ? "💸" : "📥"}
                  </div>

                  <div>

                    <div class="transaction-title">
                      ${escapeHTML(transaction.title)}
                    </div>

                    <div class="transaction-date">
                      ${escapeHTML(transaction.date)}
                    </div>

                  </div>

                </div>


                <div
                  class="amount ${isSent ? "sent" : "received"}">

                  ${isSent ? "-" : "+"}
                  ${formatCDF(transaction.amount)}

                </div>

              </div>

            `;

          })
          .join("");


      container.innerHTML = list;

    });

  }


  /* =========================
     MESSAGES
  ========================= */

  function sendMessage() {

    const input =
      document.getElementById("messageInput");

    const text =
      input.value.trim();


    if (!text) {

      toast("Écrivez un message.");

      return;
    }


    messages.push({

      text: text,

      date: new Date().toLocaleString("fr-FR"),

      me: true

    });


    saveData();

    input.value = "";

    renderMessages();

    toast("Message envoyé.");

  }


  function renderMessages() {

    const container =
      document.getElementById("messageList");


    if (!container) return;


    if (messages.length === 0) {

      container.innerHTML = `
        <div class="empty">
          Aucun message pour le moment.
        </div>
      `;

      return;

    }


    container.innerHTML =
      messages
        .map(message => {

          return `

            <div class="message ${message.me ? "me" : ""}">

              ${escapeHTML(message.text)}

              <small>
                ${escapeHTML(message.date)}
              </small>

            </div>

          `;

        })
        .join("");


    container.scrollTop =
      container.scrollHeight;

  }


  /* =========================
     SAUVEGARDE
  ========================= */

  function saveData() {

    localStorage.setItem(
      "baggiraBalance",
      balance
    );

    localStorage.setItem(
      "baggiraTransactions",
      JSON.stringify(transactions)
    );

    localStorage.setItem(
      "baggiraMessages",
      JSON.stringify(messages)
    );

  }


  /* =========================
     PROTECTION HTML
  ========================= */

  function escapeHTML(text) {

    return String(text)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  }


  /* =========================
     INITIALISATION
  ========================= */

  updateBalance();

  renderTransactions();

  renderMessages();

</script>

</body>
</html>
