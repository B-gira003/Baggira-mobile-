<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Baggira Mobile</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f7f6;
      color: #17201d;
      min-height: 100vh;
    }

    .app {
      max-width: 600px;
      margin: auto;
      padding-bottom: 30px;
    }

    /* En-tête */
    .header {
      background: #07865f;
      color: white;
      padding: 28px 24px 32px;
      border-radius: 0 0 35px 35px;
    }

    .header h1 {
      font-size: 30px;
      margin-bottom: 25px;
    }

    .welcome {
      font-size: 18px;
      margin-bottom: 15px;
    }

    .balance {
      font-size: 40px;
      font-weight: bold;
    }

    /* Contenu */
    .content {
      padding: 25px 18px;
    }

    .card {
      background: white;
      border-radius: 25px;
      padding: 25px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.07);
    }

    .card h2 {
      font-size: 28px;
      margin-bottom: 18px;
    }

    .line {
      height: 1px;
      background: #e5e5e5;
      margin-bottom: 25px;
    }

    /* Actions */
    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .action {
      border: none;
      background: #edf8f5;
      border-radius: 22px;
      padding: 28px 10px;
      min-height: 150px;
      cursor: pointer;
      transition: transform 0.15s, background 0.15s;
      font-size: 18px;
    }

    .action:active {
      transform: scale(0.96);
      background: #d9f0e9;
    }

    .icon {
      display: block;
      font-size: 42px;
      margin-bottom: 15px;
    }

    .action span:last-child {
      font-size: 18px;
    }

    /* Pages */
    .page {
      display: none;
    }

    .page.active {
      display: block;
    }

    .back {
      border: none;
      background: none;
      color: #07865f;
      font-size: 18px;
      font-weight: bold;
      padding: 5px 0 20px;
      cursor: pointer;
    }

    .page-title {
      font-size: 30px;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-weight: bold;
      margin-bottom: 8px;
    }

    input, textarea {
      width: 100%;
      padding: 15px;
      border: 1px solid #d6dedb;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
    }

    input:focus, textarea:focus {
      border-color: #07865f;
    }

    textarea {
      min-height: 110px;
      resize: vertical;
    }

    .primary-btn {
      width: 100%;
      border: none;
      background: #07865f;
      color: white;
      padding: 16px;
      border-radius: 14px;
      font-size: 18px;
      font-weight: bold;
      cursor: pointer;
      margin-top: 8px;
    }

    .primary-btn:active {
      transform: scale(0.98);
    }

    /* Solde portefeuille */
    .wallet-balance {
      background: #07865f;
      color: white;
      padding: 25px;
      border-radius: 20px;
      margin-bottom: 20px;
    }

    .wallet-balance p {
      margin-bottom: 10px;
    }

    .wallet-balance strong {
      font-size: 34px;
    }

    /* Messages */
    .message {
      background: #edf8f5;
      padding: 15px;
      border-radius: 15px;
      margin-bottom: 12px;
    }

    .message strong {
      display: block;
      margin-bottom: 5px;
    }

    /* Historique */
    .transaction {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 0;
      border-bottom: 1px solid #eee;
    }

    .transaction:last-child {
      border-bottom: none;
    }

    .green {
      color: #07865f;
      font-weight: bold;
    }

    .red {
      color: #d63c3c;
      font-weight: bold;
    }

    .empty {
      text-align: center;
      color: #777;
      padding: 25px 0;
    }

    /* Notification */
    .toast {
      position: fixed;
      left: 50%;
      bottom: 25px;
      transform: translateX(-50%);
      background: #17201d;
      color: white;
      padding: 14px 20px;
      border-radius: 12px;
      display: none;
      z-index: 1000;
      max-width: 90%;
      text-align: center;
    }

    .toast.show {
      display: block;
    }

    @media (max-width: 400px) {
      .actions {
        gap: 12px;
      }

      .action {
        min-height: 135px;
      }

      .balance {
        font-size: 34px;
      }
    }
  </style>
</head>

<body>

<div class="app">

  <!-- =========================
       ACCUEIL
  ========================== -->
  <section id="home" class="page active">

    <div class="header">
      <h1>Baggira Mobile</h1>

      <div class="welcome">
        Bienvenue 👋
      </div>

      <div class="balance" id="homeBalance">
        250 000 CDF
      </div>
    </div>

    <div class="content">
      <div class="card">

        <h2>Actions rapides</h2>
        <div class="line"></div>

        <div class="actions">

          <button class="action" onclick="showPage('send')">
            <span class="icon">💸</span>
            <span>Envoyer</span>
          </button>

          <button class="action" onclick="showPage('receive')">
            <span class="icon">📥</span>
            <span>Recevoir</span>
          </button>

          <button class="action" onclick="showPage('messages')">
            <span class="icon">💬</span>
            <span>Messages</span>
          </button>

          <button class="action" onclick="showPage('wallet')">
            <span class="icon">💰</span>
            <span>Portefeuille</span>
          </button>

        </div>

      </div>
    </div>
  </section>


  <!-- =========================
       ENVOYER
  ========================== -->
  <section id="send" class="page">

    <div class="content">

      <button class="back" onclick="showPage('home')">
        ← Retour
      </button>

      <div class="card">

        <h1 class="page-title">💸 Envoyer</h1>

        <div class="wallet-balance">
          <p>Solde disponible</p>
          <strong id="sendBalance">250 000 CDF</strong>
        </div>

        <div class="form-group">
          <label for="recipient">Numéro du destinataire</label>
          <input
            type="tel"
            id="recipient"
            placeholder="Ex. 0812345678">
        </div>

        <div class="form-group">
          <label for="sendAmount">Montant (CDF)</label>
          <input
            type="number"
            id="sendAmount"
            placeholder="Ex. 10000"
            min="1">
        </div>

        <div class="form-group">
          <label for="sendNote">Motif (facultatif)</label>
          <textarea
            id="sendNote"
            placeholder="Motif du transfert..."></textarea>
        </div>

        <button class="primary-btn" onclick="sendMoney()">
          Envoyer l'argent
        </button>

      </div>
    </div>
  </section>


  <!-- =========================
       RECEVOIR
  ========================== -->
  <section id="receive" class="page">

    <div class="content">

      <button class="back" onclick="showPage('home')">
        ← Retour
      </button>

      <div class="card">

        <h1 class="page-title">📥 Recevoir</h1>

        <div class="wallet-balance">
          <p>Votre numéro Baggira Mobile</p>
          <strong>+243 000 000 000</strong>
        </div>

        <div class="form-group">
          <label for="receiveAmount">Montant attendu (CDF)</label>
          <input
            type="number"
            id="receiveAmount"
            placeholder="Ex. 25000"
            min="1">
        </div>

        <button class="primary-btn" onclick="createRequest()">
          Créer une demande
        </button>

        <div style="margin-top:25px;">
          <p id="receiveResult" class="empty">
            Aucun paiement demandé.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- =========================
       MESSAGES
  ========================== -->
  <section id="messages" class="page">

    <div class="content">

      <button class="back" onclick="showPage('home')">
        ← Retour
      </button>

      <div class="card">

        <h1 class="page-title">💬 Messages</h1>

        <div id="messageList">

          <div class="message">
            <strong>Baggira Mobile</strong>
            Bienvenue sur votre espace de messagerie.
          </div>

        </div>

        <div class="form-group" style="margin-top:20px;">
          <label for="newMessage">Nouveau message</label>

          <textarea
            id="newMessage"
            placeholder="Écrivez votre message..."></textarea>
        </div>

        <button class="primary-btn" onclick="sendMessage()">
          Envoyer le message
        </button>

      </div>
    </div>
  </section>


  <!-- =========================
       PORTEFEUILLE
  ========================== -->
  <section id="wallet" class="page">

    <div class="content">

      <button class="back" onclick="showPage('home')">
        ← Retour
      </button>

      <div class="card">

        <h1 class="page-title">💰 Portefeuille</h1>

        <div class="wallet-balance">
          <p>Solde actuel</p>
          <strong id="walletBalance">250 000 CDF</strong>
        </div>

        <h2 style="font-size:22px; margin-bottom:10px;">
          Historique
        </h2>

        <div id="transactions">

          <div class="transaction">
            <div>
              <strong>Solde initial</strong><br>
              <small>Baggira Mobile</small>
            </div>

            <div class="green">
              +250 000 CDF
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

</div>


<!-- Notification -->
<div id="toast" class="toast"></div>


<script>

  /* =========================
     DONNÉES DE L'APPLICATION
  ========================== */

  let balance = 250000;

  let transactions = [
    {
      type: "credit",
      title: "Solde initial",
      amount: 250000,
      note: "Baggira Mobile"
    }
  ];


  /* =========================
     AFFICHAGE DES PAGES
  ========================== */

  function showPage(pageId) {

    const pages = document.querySelectorAll(".page");

    pages.forEach(function(page) {
      page.classList.remove("active");
    });

    const selectedPage = document.getElementById(pageId);

    if (selectedPage) {
      selectedPage.classList.add("active");
    }

    window.scrollTo({
      top: 0,
      behavior: "smooth"
    });

    updateBalanceDisplay();
  }


  /* =========================
     FORMATAGE DE L'ARGENT
  ========================== */

  function formatMoney(amount) {

    return Number(amount).toLocaleString("fr-FR") + " CDF";

  }


  /* =========================
     METTRE À JOUR LE SOLDE
  ========================== */

  function updateBalanceDisplay() {

    document.getElementById("homeBalance").textContent =
      formatMoney(balance);

    document.getElementById("sendBalance").textContent =
      formatMoney(balance);

    document.getElementById("walletBalance").textContent =
      formatMoney(balance);

    renderTransactions();
  }


  /* =========================
     ENVOYER DE L'ARGENT
  ========================== */

  function sendMoney() {

    const recipient =
      document.getElementById("recipient").value.trim();

    const amount =
      Number(document.getElementById("sendAmount").value);

    const note =
      document.getElementById("sendNote").value.trim();


    if (!recipient) {

      showToast("Veuillez entrer le numéro du destinataire.");

      return;
    }


    if (!amount || amount <= 0) {

      showToast("Veuillez entrer un montant valide.");

      return;
    }


    if (amount > balance) {

      showToast("Solde insuffisant.");

      return;
    }


    /* Retirer le montant */

    balance -= amount;


    /* Ajouter à l'historique */

    transactions.unshift({
      type: "debit",
      title: "Envoi à " + recipient,
      amount: amount,
      note: note || "Transfert"
    });


    /* Vider les champs */

    document.getElementById("recipient").value = "";
    document.getElementById("sendAmount").value = "";
    document.getElementById("sendNote").value = "";


    updateBalanceDisplay();


    showToast(
      "Transfert de " +
      formatMoney(amount) +
      " effectué."
    );


    /* Retour portefeuille après 1 seconde */

    setTimeout(function() {

      showPage("wallet");

    }, 1200);

  }


  /* =========================
     DEMANDE DE PAIEMENT
  ========================== */

  function createRequest() {

    const amount =
      Number(document.getElementById("receiveAmount").value);


    if (!amount || amount <= 0) {

      showToast("Entrez un montant valide.");

      return;
    }


    const requestCode =
      "BAG-" +
      Math.floor(100000 + Math.random() * 900000);


    document.getElementById("receiveResult").innerHTML =
      "Demande créée avec succès.<br><br>" +
      "<strong>" + formatMoney(amount) + "</strong><br>" +
      "Code : <strong>" + requestCode + "</strong>";


    document.getElementById("receiveAmount").value = "";


    showToast("Demande de paiement créée.");

  }


  /* =========================
     MESSAGES
  ========================== */

  function sendMessage() {

    const message =
      document.getElementById("newMessage").value.trim();


    if (!message) {

      showToast("Écrivez un message.");

      return;
    }


    const messageList =
      document.getElementById("messageList");


    const newMessage =
      document.createElement("div");


    newMessage.className = "message";


    newMessage.innerHTML =
      "<strong>Vous</strong>" +
      escapeHtml(message);


    messageList.prepend(newMessage);


    document.getElementById("newMessage").value = "";


    showToast("Message envoyé.");

  }


  /* =========================
     HISTORIQUE PORTEFEUILLE
  ========================== */

  function renderTransactions() {

    const container =
      document.getElementById("transactions");


    if (!transactions.length) {

      container.innerHTML =
        '<div class="empty">Aucune transaction.</div>';

      return;
    }


    container.innerHTML = "";


    transactions.forEach(function(transaction) {

      const item =
        document.createElement("div");


      item.className = "transaction";


      const sign =
        transaction.type === "credit"
        ? "+"
        : "-";


      const colorClass =
        transaction.type === "credit"
        ? "green"
        : "red";


      item.innerHTML =

        "<div>" +
          "<strong>" +
            escapeHtml(transaction.title) +
          "</strong><br>" +
          "<small>" +
            escapeHtml(transaction.note || "") +
          "</small>" +
        "</div>" +

        "<div class='" + colorClass + "'>" +
          sign +
          " " +
          formatMoney(transaction.amount) +
        "</div>";


      container.appendChild(item);

    });

  }


  /* =========================
     SÉCURITÉ POUR LES MESSAGES
  ========================== */

  function escapeHtml(text) {

    const div =
      document.createElement("div");

    div.textContent = text;

    return div.innerHTML;

  }


  /* =========================
     NOTIFICATION
  ========================== */

  function showToast(message) {

    const toast =
      document.getElementById("toast");


    toast.textContent = message;

    toast.classList.add("show");


    setTimeout(function() {

      toast.classList.remove("show");

    }, 2500);

  }


  /* =========================
     INITIALISATION
  ========================== */

  updateBalanceDisplay();

</script>

</body>
</html>
